{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-security-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/security/{**catch-all}"
        }
      },
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/employees/{**catch-all}"
        }
      },
      "recruitment-route": {
        "ClusterId": "recruitment-cluster",
        "Match": {
          "Path": "/api/v1/recruitment/{**catch-all}"
        }
      },
      "payroll-route": {
        "ClusterId": "payroll-cluster",
        "Match": {
          "Path": "/api/v1/payroll/{**catch-all}"
        }
      },
      "operations-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/v1/operations/{**catch-all}"
        }
      },
      "python-ai-route": {
        "ClusterId": "python-ai-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": { "Address": "http://localhost:5001/" }
        }
      },
      "employee-cluster": {
        "Destinations": {
          "employee-destination": { "Address": "http://localhost:5002/" }
        }
      },
      "recruitment-cluster": {
        "Destinations": {
          "recruitment-destination": { "Address": "http://localhost:5003/" }
        }
      },
      "payroll-cluster": {
        "Destinations": {
          "payroll-destination": { "Address": "http://localhost:5004/" }
        }
      },
      "operations-cluster": {
        "Destinations": {
          "operations-destination": { "Address": "http://localhost:5005/" }
        }
      },
      "python-ai-cluster": {
        "Destinations": {
          "python-destination": { "Address": "http://localhost:8000/" }
        }
      }
    }
  }
}
